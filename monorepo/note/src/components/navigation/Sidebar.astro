---
/**
 * Sidebar — action buttons on top, tab bar, file list grouped by type below.
 */

import {
  SquarePen,
  Trash2,
  Plus,
  Upload,
  Columns3,
  PencilRuler,
  CheckSquare,
} from "@lucide/astro";
---

<aside
  id="sidebar"
  class="w-(--sidebar-width) min-w-(--sidebar-width) h-full bg-card border-r border-border flex flex-col overflow-hidden"
>
  <!-- Action buttons at the top -->
  <div
    class="flex flex-wrap items-center gap-1.5 p-2 border-b border-border"
  >
    <button
      id="sidebar-new-file-btn"
      class="flex items-center gap-1 h-7 px-2 rounded-md text-xs font-medium bg-foreground text-background hover:bg-foreground/90 transition-colors cursor-pointer"
      title="New file"
    >
      <Plus size={12} />
      <span>New</span>
    </button>
    <button
      id="sidebar-upload-btn"
      class="flex items-center gap-1.5 h-7 px-2 rounded-md text-xs font-medium bg-secondary text-secondary-foreground border border-border hover:bg-muted transition-colors cursor-pointer"
      title="Upload files"
    >
      <Upload size={12} />
      <span>Upload</span>
    </button>
    <button
      id="sidebar-tasks-btn"
      class="flex items-center gap-1.5 h-7 px-2 rounded-md text-xs font-medium bg-secondary text-secondary-foreground border border-border hover:bg-muted transition-colors cursor-pointer"
      title="Tasks list"
    >
      <CheckSquare size={12} />
      <span>Tasks</span>
    </button>
    <button
      id="sidebar-kanban-btn"
      class="flex items-center gap-1.5 h-7 px-2 rounded-md text-xs font-medium bg-secondary text-secondary-foreground border border-border hover:bg-muted transition-colors cursor-pointer"
      title="Kanban board"
    >
      <Columns3 size={12} />
      <span>Kanban</span>
    </button>
    <button
      id="sidebar-more-tools-btn"
      class="flex items-center gap-1.5 h-7 px-2 rounded-md text-xs font-medium bg-secondary text-secondary-foreground border border-border hover:bg-muted transition-colors cursor-pointer"
      title="More tools"
    >
      <PencilRuler size={12} />
      <a href="https://tool.rafifmsn.com">More tools</a>
    </button>
  </div>

  <!-- Tab bar -->
  <div id="sidebar-tabs" class="flex border-b border-border px-1 py-1 gap-0.5">
    <!-- Tabs rendered by JS -->
  </div>

  <!-- File list container (populated by JS) -->
  <div id="sidebar-file-list" class="flex-1 overflow-y-auto p-2">
    <div
      class="flex items-center justify-center h-full text-xs text-muted-foreground"
    >
      <p>No files yet</p>
    </div>
  </div>

  <!-- Organize files button at the bottom -->
  <div class="border-t border-border p-2 flex flex-col gap-1.5">
    <button
      id="sidebar-move-mode-btn"
      class="flex items-center justify-center gap-1.5 h-7 w-full rounded-md text-xs font-medium text-muted-foreground border border-border hover:bg-muted transition-colors cursor-pointer"
      title="Toggle file organization mode"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="m16 3 4 4-4 4"></path><path d="M20 7H4a2 2 0 0 0-2 2v10"
        ></path><path d="m8 21-4-4 4-4"></path><path
          d="M4 17h16a2 2 0 0 0 2-2V5"></path></svg
      >
      <span>Move Files</span>
    </button>
    <button
      id="sidebar-delete-all-btn"
      class="flex items-center justify-center gap-1.5 h-7 w-full rounded-md text-xs font-medium text-red-400 border border-red-400/30 hover:bg-red-400/10 transition-colors cursor-pointer"
      title="Delete all files and assets in current tab"
    >
      <Trash2 size={14} />
      <span>Delete All</span>
    </button>
  </div>
</aside>

<!-- Hidden Blueprints for Dynamic Client Injection -->
<div id="sidebar-icon-blueprints" class="hidden">
  <div id="blueprint-edit"><SquarePen size={14} /></div>
  <div id="blueprint-trash"><Trash2 size={14} /></div>
</div>

<script>
  import {
    getAllFiles,
    getAllAssets,
    deleteFile,
    deleteAsset,
    getAsset,
    saveFile,
    generateId,
    renameFile,
    renameAsset,
    deleteAllFiles,
    deleteAllAssets,
    getTabs,
    initDefaultTabs,
    moveFile,
    moveAsset,
    type Tab,
  } from "../../services/db";
  import { LightboxModal } from "../modals/LightboxModal";
  import { ConfirmTooltip } from "../ui/ConfirmTooltip";
  import { FileUploadModal } from "../modals/FileUploadModal";

  interface GroupedItem {
    id: string;
    name: string;
    type: "markdown" | "image" | "pdf";
  }

  let activeFileId: string | null = null;
  let activeTabId: string | null = null;
  let tabs: Tab[] = [];

  const TAB_KEY = "note-active-tab";

  Object.defineProperty(window, "__activeFileId", {
    get: () => activeFileId,
    configurable: true,
  });

  Object.defineProperty(window, "__activeTabId", {
    get: () => activeTabId,
    configurable: true,
  });

  // ── Action buttons ──

  document
    .getElementById("sidebar-kanban-btn")
    ?.addEventListener("click", () => {
      location.href = "/kanban";
    });

  document
    .getElementById("sidebar-tasks-btn")
    ?.addEventListener("click", () => {
      location.href = "/tasks";
    });

  document
    .getElementById("sidebar-new-file-btn")
    ?.addEventListener("click", async () => {
      const name = `note-${Date.now()}.md`;
      const id = generateId();
      const tid = activeTabId || tabs[0]?.id || "";
      await saveFile({
        id,
        name,
        content: "",
        type: "markdown",
        tabId: tid,
        updatedAt: Date.now(),
      });
      selectFile(id);
      document.dispatchEvent(new CustomEvent("file-created", { detail: { fileId: id } }));
      document.dispatchEvent(new CustomEvent("file-list-changed"));
    });

  let isMoveMode = false;

  document
    .getElementById("sidebar-move-mode-btn")
    ?.addEventListener("click", () => {
      isMoveMode = !isMoveMode;
      const moveBtn = document.getElementById("sidebar-move-mode-btn");
      if (moveBtn) {
        if (isMoveMode) {
          moveBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Done Organizing</span>
      `;
          moveBtn.classList.add("bg-foreground/10", "text-foreground", "border-border");
          moveBtn.classList.remove("text-muted-foreground");
        } else {
          moveBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4a2 2 0 0 0-2 2v10"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16a2 2 0 0 0 2-2V5"/></svg>
        <span>Move Files</span>
      `;
          moveBtn.classList.remove(
            "bg-foreground/10",
            "text-foreground",
            "border-border",
          );
          moveBtn.classList.add("text-muted-foreground");
        }
      }
      renderSidebar();
    });

  document
    .getElementById("sidebar-upload-btn")
    ?.addEventListener("click", () => {
      new FileUploadModal(() => {});
    });

  document
    .getElementById("sidebar-delete-all-btn")
    ?.addEventListener("click", () => {
      const btn = document.getElementById("sidebar-delete-all-btn")!;
      const tabName =
        tabs.find((t) => t.id === activeTabId)?.name || "this tab";
      const tooltip = new ConfirmTooltip(btn, {
        message: `Delete all in "${tabName}"?`,
        onConfirm: async () => {
          await deleteAllFiles(activeTabId || undefined);
          await deleteAllAssets(activeTabId || undefined);
          activeFileId = null;
          document.dispatchEvent(
            new CustomEvent("file-selected", { detail: { fileId: null } }),
          );
          renderSidebar();
        },
        onCancel: () => {},
      });
      document.querySelectorAll('[role="tooltip"]').forEach((t) => t.remove());
      tooltip.show();
    });

  // ── Tab management ──

  async function initTabs() {
    tabs = await initDefaultTabs();
    const saved = localStorage.getItem(TAB_KEY);
    if (saved && tabs.some((t) => t.id === saved)) {
      activeTabId = saved;
    } else {
      activeTabId = tabs[0]?.id || null;
    }
    renderTabs();
    renderSidebar();
  }

  function renderTabs() {
    const container = document.getElementById("sidebar-tabs");
    if (!container) return;
    container.innerHTML = "";
    for (const tab of tabs) {
      const btn = document.createElement("button");
      btn.className = `flex-1 px-2 py-1 text-xs rounded transition-colors cursor-pointer font-medium ${
        tab.id === activeTabId
          ? "bg-muted text-foreground"
          : "text-muted-foreground hover:text-foreground hover:bg-muted/50"
      }`;
      btn.textContent = tab.name;
      btn.dataset.tabId = tab.id;
      btn.addEventListener("click", () => {
        activeTabId = tab.id;
        localStorage.setItem(TAB_KEY, tab.id);
        renderTabs();
        renderSidebar();
        // Deselect current file when switching tabs
        if (activeFileId) {
          activeFileId = null;
          document.dispatchEvent(
            new CustomEvent("file-selected", { detail: { fileId: null } }),
          );
        }
      });
      container.appendChild(btn);
    }
  }

  // ── File list rendering ──

  async function renderSidebar() {
    const container = document.getElementById("sidebar-file-list");
    if (!container) return;

    const files = await getAllFiles(activeTabId || undefined);
    const assets = await getAllAssets(activeTabId || undefined);

    const mdItems: GroupedItem[] = files.map((f) => ({
      id: f.id,
      name: f.name,
      type: "markdown",
    }));
    const imgItems: GroupedItem[] = assets
      .filter((a) => a.type === "image")
      .map((a) => ({ id: a.id, name: a.name, type: "image" }));
    const pdfItems: GroupedItem[] = assets
      .filter((a) => a.type === "pdf")
      .map((a) => ({ id: a.id, name: a.name, type: "pdf" }));

    container.innerHTML = "";

    const renderGroup = (
      label: string,
      items: GroupedItem[],
      emptyMsg: string,
    ) => {
      const section = document.createElement("div");
      section.className = "mb-3";
      const header = document.createElement("div");
      header.className =
        "flex items-center justify-between pl-2 pr-5 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground font-secondary";
      header.innerHTML = `<span>${label}</span><span>${items.length}</span>`;
      section.appendChild(header);

      if (items.length === 0) {
        const empty = document.createElement("div");
        empty.className = "px-2 py-2 text-xs text-muted-foreground";
        empty.textContent = emptyMsg;
        section.appendChild(empty);
      } else {
        for (const item of items) {
          const row = document.createElement("div");
          row.className =
            "flex items-center h-8 px-2 rounded-md text-sm text-muted-foreground hover:bg-muted group cursor-pointer transition-colors";
          row.dataset.fileId = item.id;
          row.dataset.fileType = item.type;

          const nameSpan = document.createElement("span");
          nameSpan.className =
            "flex-1 truncate text-[13px] block h-5 leading-5 my-auto pr-1";
          nameSpan.textContent = item.name;
          nameSpan.setAttribute("data-name-span", "");
          row.appendChild(nameSpan);

          if (isMoveMode) {
            const select = document.createElement("select");
            select.className =
              "move-file-select ml-auto bg-popover h-6 border border-border rounded text-[11px] px-1 py-0.5 max-w-[80px] outline-none text-muted-foreground hover:text-foreground transition-colors cursor-pointer";
            select.setAttribute("aria-label", `Move ${item.name} to tab`);

            const optPlaceholder = document.createElement("option");
            optPlaceholder.value = "";
            optPlaceholder.disabled = true;
            optPlaceholder.selected = true;
            optPlaceholder.textContent = "Move...";
            select.appendChild(optPlaceholder);

            for (const tab of tabs) {
              if (tab.id !== activeTabId) {
                const opt = document.createElement("option");
                opt.value = tab.id;
                opt.textContent = tab.name;
                select.appendChild(opt);
              }
            }

            select.addEventListener("click", (e) => e.stopPropagation());
            select.addEventListener("mousedown", (e) => e.stopPropagation());

            select.addEventListener("change", async (e) => {
              const targetTabId = (e.target as HTMLSelectElement).value;
              if (!targetTabId) return;

              if (item.type === "markdown") {
                await moveFile(item.id, targetTabId);
                if (activeFileId === item.id) {
                  activeFileId = null;
                  document.dispatchEvent(
                    new CustomEvent("file-selected", {
                      detail: { fileId: null },
                    }),
                  );
                }
              } else {
                await moveAsset(item.id, targetTabId);
              }

              document.dispatchEvent(new CustomEvent("file-list-changed"));
            });

            row.appendChild(select);
          } else {
            // ── Rename Button Setup ──
            const renameBtn = document.createElement("button");
            renameBtn.className =
              "icon-btn icon-btn--secondary ml-0.5 transition-opacity lg:opacity-0 lg:group-hover:opacity-100";
            renameBtn.setAttribute("aria-label", `Rename ${item.name}`);

            const editIcon = document
              .getElementById("blueprint-edit")
              ?.firstElementChild?.cloneNode(true);
            if (editIcon) renameBtn.appendChild(editIcon);
            row.appendChild(renameBtn);

            renameBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              startInlineRename(item, row);
            });

            // ── Trash Button Setup ──
            const trashBtn = document.createElement("button");
            trashBtn.className =
              "icon-btn icon-btn--danger text-muted-foreground ml-0.5 transition-opacity lg:opacity-0 lg:group-hover:opacity-100";
            trashBtn.setAttribute("aria-label", `Delete ${item.name}`);

            const trashIcon = document
              .getElementById("blueprint-trash")
              ?.firstElementChild?.cloneNode(true);
            if (trashIcon) trashBtn.appendChild(trashIcon);
            row.appendChild(trashBtn);

            trashBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              const tooltip = new ConfirmTooltip(trashBtn, {
                onConfirm: async () => {
                  await deleteItem(item);
                  renderSidebar();
                },
                onCancel: () => {},
              });
              if (tooltip.isVisible()) tooltip.hide();
              else {
                document
                  .querySelectorAll('[role="tooltip"]')
                  .forEach((t) => t.remove());
                tooltip.show();
              }
            });
          }

          if (item.type === "markdown") {
            row.addEventListener("click", () => selectFile(item.id));
          } else {
            row.addEventListener("click", async () => {
              await previewAsset(item);
            });
          }

          if (item.id === activeFileId) {
            row.classList.remove("hover:bg-muted");
            row.classList.add("bg-accent", "text-accent-foreground");
          }
          section.appendChild(row);
        }
      }
      container.appendChild(section);
    };

    renderGroup("Markdown", mdItems, "No markdown files");
    renderGroup("Images", imgItems, "No images");
    renderGroup("PDFs", pdfItems, "No PDFs");
  }

  function selectFile(fileId: string) {
    activeFileId = fileId;
    document.dispatchEvent(
      new CustomEvent("file-selected", { detail: { fileId } }),
    );
    renderSidebar();
  }

  async function previewAsset(item: GroupedItem) {
    const asset = await getAsset(item.id);
    if (!asset) return;
    // Update highlight to this asset
    activeFileId = item.id;
    renderSidebar();

    if (asset.type === "image") {
      const url = URL.createObjectURL(asset.data);
      new LightboxModal(url, () => URL.revokeObjectURL(url));
    } else if (asset.type === "pdf") {
      const url = URL.createObjectURL(asset.data);
      const pdfViewer = document.getElementById("pdf-viewer");
      const emptyState = document.getElementById("empty-state");
      const editorWrapper = document.getElementById("editor-wrapper");
      if (pdfViewer) {
        emptyState?.classList.add("hidden");
        editorWrapper?.classList.add("hidden");
        document.getElementById("btn-toggle-preview")?.classList.add("hidden");
        pdfViewer.classList.add("active");
        pdfViewer.innerHTML = `
        <div class="flex flex-col md:flex-row md:items-center md:justify-between px-4 py-2 border-b border-border bg-card shrink-0">
          <span class="text-sm text-muted-foreground truncate">${asset.name}</span>
          <a href="${url}" target="_blank" class="text-xs text-muted-foreground hover:text-foreground underline underline-offset-2 text-balance">Open in new tab</a>
        </div>
        <iframe src="${url}" class="flex-1 w-full border-none"></iframe>
      `;
      }
    }
  }

  // ── Inline rename ──

  function startInlineRename(item: GroupedItem, row: HTMLElement) {
    const nameSpan = row.querySelector("[data-name-span]") as HTMLElement;
    if (!nameSpan) return;
    const currentName = item.name;

    const input = document.createElement("input");
    input.type = "text";
    input.value = currentName;
    input.className =
      "flex-1 min-w-0 px-1 py-0.5 text-[13px] bg-muted border border-border rounded outline-none text-foreground";
    input.setAttribute("data-rename-input", "");

    nameSpan.replaceWith(input);
    // Prevent row click events from firing while renaming
    input.addEventListener("mousedown", (e) => e.stopPropagation());
    input.addEventListener("click", (e) => e.stopPropagation());
    input.focus();

    const dotIndex = currentName.lastIndexOf(".");
    if (dotIndex > 0) {
      input.setSelectionRange(0, dotIndex);
    } else {
      input.select();
    }

    const finishRename = async () => {
      const newName = input.value.trim();
      if (newName && newName !== currentName) {
        if (item.type === "markdown") {
          await renameFile(item.id, newName);
        } else {
          await renameAsset(item.id, newName);
        }
        item.name = newName;
        document.dispatchEvent(new CustomEvent("file-list-changed"));
      } else {
        renderSidebar();
      }
    };

    input.addEventListener("blur", finishRename);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        input.blur();
      } else if (e.key === "Escape") {
        e.preventDefault();
        renderSidebar();
      }
    });
  }

  async function deleteItem(item: GroupedItem) {
    if (item.type === "markdown") {
      await deleteFile(item.id);
      if (activeFileId === item.id) {
        activeFileId = null;
        document.dispatchEvent(
          new CustomEvent("file-selected", { detail: { fileId: null } }),
        );
      }
    } else {
      await deleteAsset(item.id);
      const pdfViewer = document.getElementById("pdf-viewer");
      if (pdfViewer?.classList.contains("active")) {
        const headerText = pdfViewer.querySelector("span")?.textContent;
        if (headerText === item.name) {
          pdfViewer.classList.remove("active");
          pdfViewer.innerHTML = "";
          document.getElementById("empty-state")?.classList.remove("hidden");
        }
      }
    }
  }

  document.addEventListener("file-list-changed", () => renderSidebar());

  // ── Open file by ID (from external redirect, e.g. share.astro) ──
  document.addEventListener("open-file-by-id", ((e: Event) => {
    const ce = e as CustomEvent;
    const fileId = ce.detail.fileId;
    if (fileId) {
      selectFile(fileId);
    }
  }) as EventListener);

  initTabs();
</script>
