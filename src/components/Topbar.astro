---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex items-center justify-between h-12 px-4 border-b border-border bg-card">
  <div class="flex items-center gap-2 min-w-0">
    <a href="/" class="text-sm font-semibold text-foreground no-underline tracking-tight whitespace-nowrap">Tool</a>
    <span class="text-muted-foreground/60 text-xs shrink-0">/</span>
    <span id="topbar-title" class="text-sm text-muted-foreground truncate">{title}</span>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <slot name="actions" />
  </div>
</div>

<style>
  a {
    text-decoration: none;
  }
</style>
